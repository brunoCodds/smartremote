<?xml version="1.0" encoding="utf-8"?>
<!--
    Fundo padrão de qualquer BottomSheet do app (apps, teclado, texto
    livre, e futuros). Superfície elevada + cantos superiores grandes,
    consistente com Widget.Fluent.BottomSheet em themes.xml.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceElevated" />
    <corners
        android:topLeftRadius="28dp"
        android:topRightRadius="28dp" />
</shape>
