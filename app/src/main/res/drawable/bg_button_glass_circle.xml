<?xml version="1.0" encoding="utf-8"?>
<!--
    Base de TODO botão circular do Fluent (D-pad, back/home/play,
    volume, canal, power, assistente...). Substitui os antigos
    ripple_circle*.xml individuais — um único drawable reutilizável,
    a diferenciação de cor de ícone fica no style (ver
    Widget.Fluent.Button.Glass.Circle / .Danger em themes.xml), não
    aqui.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorAccentContainer">
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/colorGlassFill" />
            <stroke
                android:width="1dp"
                android:color="?attr/colorGlassStroke" />
        </shape>
    </item>
</ripple>
