<?xml version="1.0" encoding="utf-8"?>
<!--
    Mesmo vidro fosco de bg_glass_fill, mas com a borda no colorAccent
    do tema ativo — usado em estados selecionado/conectado/focado.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorGlassFill" />
    <stroke
        android:width="1.5dp"
        android:color="?attr/colorAccent" />
    <corners android:radius="18dp" />
</shape>
