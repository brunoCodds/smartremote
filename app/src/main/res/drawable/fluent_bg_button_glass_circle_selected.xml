<?xml version="1.0" encoding="utf-8"?>
<!--
    Variante de bg_button_glass_circle com borda em colorAccent —
    usada por exemplo no botão OK do D-pad ou em qualquer botão
    circular que precise indicar destaque/estado ativo.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorAccentContainer">
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/colorGlassFill" />
            <stroke
                android:width="1.5dp"
                android:color="?attr/colorAccent" />
        </shape>
    </item>
</ripple>
