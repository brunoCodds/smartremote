<?xml version="1.0" encoding="utf-8"?>
<!--
    Item de FAQ: card Fluent com pergunta (sempre visível, com chevron
    indicando estado) + resposta (GONE por padrão, revelada ao tocar - ver
    FaqAdapter.ViewHolder.bind). Reaproveita Widget.Fluent.Card.Glass, sem
    nenhum widget novo de card - só compõe TextViews dentro dele.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Fluent.Card.Glass"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="?attr/colorGlassFill">

    <LinearLayout
        android:id="@+id/layoutFaqItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtFaqQuestion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Fluent.Body"
                android:textColor="?attr/colorTextPrimary"
                android:textStyle="bold"
                tools:text="Por que minha TV não aparece na busca?" />

            <ImageView
                android:id="@+id/imgFaqChevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_chevron_down"
                android:tint="?attr/colorTextSecondary"
                android:contentDescription="@string/desc_faq_expand" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtFaqAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="@style/TextAppearance.Fluent.Caption"
            android:visibility="gone"
            tools:text="A TV e o celular precisam estar na mesma rede Wi-Fi..." />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
