<?xml version="1.0" encoding="utf-8"?>
<!--
    Conteúdo do menu lateral (Navigation Drawer) da MainActivity.
    Arquivo separado (incluído via <include> em activity_main.xml) para não
    inflar ainda mais um layout que já é grande - é o único <include> do
    projeto até agora, mas o padrão de ViewBinding funciona normalmente
    (acessível em MainActivity como binding.drawerContent.<id>).

    Itens simples (sem RecyclerView - são poucos e fixos, não precisa da
    complexidade de um adapter para isso), cada um um LinearLayout
    clicável com ícone + texto, seguindo o mesmo espírito visual do resto
    do app (Widget.Fluent.*, ?attr/colorXxx, nunca cor fixa).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceElevated"
    android:orientation="vertical"
    android:paddingTop="32dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="24dp"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.Fluent.DialogTitle"
        android:textColor="?attr/colorTextPrimary" />

    <!-- Pareamento de TV - abre a mesma DeviceDiscoveryActivity de sempre (antes acessível direto pelo btnSettings). -->
    <LinearLayout
        android:id="@+id/itemPairing"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_tv"
            android:tint="?attr/colorTextPrimary"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="@string/drawer_item_pairing"
            android:textAppearance="@style/TextAppearance.Fluent.Body" />
    </LinearLayout>

    <!-- Diagnóstico Aprofundado - v0.9.3, item 4. -->
    <LinearLayout
        android:id="@+id/itemDeepDiagnostic"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_search"
            android:tint="?attr/colorTextPrimary"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="@string/drawer_item_deep_diagnostic"
            android:textAppearance="@style/TextAppearance.Fluent.Body" />
    </LinearLayout>

    <!-- FAQ -->
    <LinearLayout
        android:id="@+id/itemFaq"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_faq"
            android:tint="?attr/colorTextPrimary"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="@string/drawer_item_faq"
            android:textAppearance="@style/TextAppearance.Fluent.Body" />
    </LinearLayout>

    <!-- Compartilhar app -->
    <LinearLayout
        android:id="@+id/itemShare"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_share"
            android:tint="?attr/colorTextPrimary"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="@string/drawer_item_share"
            android:textAppearance="@style/TextAppearance.Fluent.Body" />
    </LinearLayout>

    <!-- Mudar idioma - abre um diálogo com as opções suportadas (ver MainActivity.showLanguagePicker). -->
    <LinearLayout
        android:id="@+id/itemLanguage"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_language"
            android:tint="?attr/colorTextPrimary"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="@string/drawer_item_language"
            android:textAppearance="@style/TextAppearance.Fluent.Body" />
    </LinearLayout>

    <!-- Espaço flexível empurra o rodapé (links do autor) para o fim do drawer. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:background="?attr/colorGlassStroke" />

    <!-- *** NOVO - v0.9.5 (configurações de auxílio ao usuário) ***: dois
         toggles rápidos aqui no rodapé, perto dos links externos, em vez
         de uma tela de Configurações completa (essa fica pra mais pra
         frente, com itens de verdade - tamanho/posição dos botões,
         permissões etc.). O clique é na LINHA inteira (mesmo padrão dos
         outros itens do drawer), não fecha o menu - a pessoa pode mexer
         nos dois toggles em sequência sem reabrir. O MaterialSwitch em si
         fica não-clicável/não-focável de propósito, só reflete o estado -
         ver MainActivity.setupDrawer(). -->
    <LinearLayout
        android:id="@+id/itemKeepScreenOn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_keep_screen_on"
            android:tint="?attr/colorTextSecondary"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/drawer_item_keep_screen_on"
            android:textAppearance="@style/TextAppearance.Fluent.Caption" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchKeepScreenOn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/itemVibrationFeedback"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_vibration"
            android:tint="?attr/colorTextSecondary"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/drawer_item_vibration_feedback"
            android:textAppearance="@style/TextAppearance.Fluent.Caption" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchVibrationFeedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/itemGithub"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_link_external"
            android:tint="?attr/colorTextSecondary"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/drawer_footer_github"
            android:textAppearance="@style/TextAppearance.Fluent.Caption" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/itemLinkedin"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_link_external"
            android:tint="?attr/colorTextSecondary"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/drawer_footer_linkedin"
            android:textAppearance="@style/TextAppearance.Fluent.Caption" />
    </LinearLayout>

</LinearLayout>
