<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Alça visual do BottomSheet -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/fluent_bg_sheet_handle" />

    <!-- ===== Linha 1 2 3 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnNum1"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/fluent_bg_button_glass_circle"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/fluent_button_press"
            android:gravity="center"
            android:text="1"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnNum2"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/fluent_bg_button_glass_circle"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/fluent_button_press"
            android:gravity="center"
            android:text="2"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnNum3"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/fluent_bg_button_glass_circle"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/fluent_button_press"
            android:gravity="center"
            android:text="3"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ===== Linha 4 5 6 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnNum4"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/fluent_bg_button_glass_circle"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/fluent_button_press"
            android:gravity="center"
            android:text="4"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnNum5"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/fluent_bg_button_glass_circle"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/fluent_button_press"
            android:gravity="center"
            android:text="5"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnNum6"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/fluent_bg_button_glass_circle"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/fluent_button_press"
            android:gravity="center"
            android:text="6"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ===== Linha 7 8 9 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnNum7"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/fluent_bg_button_glass_circle"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/fluent_button_press"
            android:gravity="center"
            android:text="7"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnNum8"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/fluent_bg_button_glass_circle"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/fluent_button_press"
            android:gravity="center"
            android:text="8"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnNum9"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/fluent_bg_button_glass_circle"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/fluent_button_press"
            android:gravity="center"
            android:text="9"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ===== Linha 0 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnNum0"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/fluent_bg_button_glass_circle"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/fluent_button_press"
            android:gravity="center"
            android:text="0"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ===== Teclas coloridas (funções HbbTV/teletexto) =====
         Cores fixas por convenção universal de controle remoto — não
         fazem parte do sistema de accent do tema (mesma lógica das
         cores de marca dos apps de streaming). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnColorRed"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/legacy_ripple_circle"
            android:backgroundTint="#E53935"
            android:clickable="true"
            android:contentDescription="@string/desc_color_red"
            android:focusable="true"
            android:stateListAnimator="@animator/fluent_button_press" />

        <TextView
            android:id="@+id/btnColorGreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/legacy_ripple_circle"
            android:backgroundTint="#43A047"
            android:clickable="true"
            android:contentDescription="@string/desc_color_green"
            android:focusable="true"
            android:stateListAnimator="@animator/fluent_button_press" />

        <TextView
            android:id="@+id/btnColorYellow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/legacy_ripple_circle"
            android:backgroundTint="#FDD835"
            android:clickable="true"
            android:contentDescription="@string/desc_color_yellow"
            android:focusable="true"
            android:stateListAnimator="@animator/fluent_button_press" />

        <TextView
            android:id="@+id/btnColorBlue"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/legacy_ripple_circle"
            android:backgroundTint="#1E88E5"
            android:clickable="true"
            android:contentDescription="@string/desc_color_blue"
            android:focusable="true"
            android:stateListAnimator="@animator/fluent_button_press" />

    </LinearLayout>

    <!-- ===== Alternar para modo texto (ABC) ===== -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnKeypadTextMode"
        style="@style/Widget.Fluent.Button.Pill.Outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/keypad_text_mode_button" />

</LinearLayout>
