<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardDevice"
    style="@style/Widget.Fluent.Card.Glass"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    app:checkedIconTint="?attr/colorAccent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Fluent.Body"
                android:textStyle="bold"
                tools:text="Samsung TV Living Room" />

            <!--
              Selo exibido quando esta TV encontrada já está pareada.
              A TV nunca é removida da lista de descoberta por já estar
              pareada — isto é apenas um indicador visual.
            -->
            <TextView
                android:id="@+id/tvPairedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:drawableStart="@drawable/ic_check"
                android:drawableTint="?attr/colorAccent"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:text="@string/device_paired_badge"
                android:textColor="?attr/colorAccent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvDeviceSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Fluent.Caption"
            tools:text="Samsung • 192.168.0.10 • SSDP" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
