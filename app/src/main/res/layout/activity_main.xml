<?xml version="1.0" encoding="utf-8"?>
<!--
    *** v0.9.3, item 3 ***: root passou de um ConstraintLayout puro para um
    DrawerLayout com dois filhos - o conteúdo principal (o mesmo
    ConstraintLayout id=root de sempre, ainda com todo o layout original
    dentro, sem nenhuma mudança estrutural interna) e o menu lateral
    (drawerContent, gravity=start). Nada dentro do ConstraintLayout id=root
    mudou de posição/constraint por causa disso - só ganhou um pai a mais.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceDeep"
    android:fitsSystemWindows="true"
    android:paddingHorizontal="24dp"
    android:paddingVertical="16dp"
    tools:context=".MainActivity">

    <!-- ===================== GLOW por trás do D-pad (puramente decorativo, sem id) ===================== -->
    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:background="@drawable/fluent_bg_accent_glow"
        app:layout_constraintBottom_toBottomOf="@id/dpadContainer"
        app:layout_constraintEnd_toEndOf="@id/dpadContainer"
        app:layout_constraintStart_toStartOf="@id/dpadContainer"
        app:layout_constraintTop_toTopOf="@id/dpadContainer" />

    <!-- ===================== DIAGNÓSTICO (painel de debug, apenas dev) ===================== -->
    <ImageView
        android:id="@+id/btnInfo"
        style="@style/Widget.Fluent.IconCircle.Secondary"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:src="@drawable/ic_info"
        android:contentDescription="@string/desc_diagnostic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ===================== MENU LATERAL (abre o drawer - v0.9.3, item 3) ===================== -->
    <ImageView
        android:id="@+id/btnSettings"
        style="@style/Widget.Fluent.IconCircle.Secondary"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:src="@drawable/ic_settings"
        android:contentDescription="@string/desc_open_menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ===================== TOPO: Power / 123 / ABC / Assistente ===================== -->
    <LinearLayout
        android:id="@+id/rowTop"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread">

        <ImageView
            android:id="@+id/btnPower"
            style="@style/Widget.Fluent.IconCircle.Danger"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="15dp"
            android:src="@drawable/ic_power"
            android:contentDescription="@string/desc_power" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeyboard"
            style="@style/Widget.Fluent.Button.Pill"
            android:layout_width="58dp"
            android:layout_height="34dp"
            android:layout_marginStart="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="0dp"
            android:paddingVertical="0dp"
            android:text="123"
            android:textSize="14sp"
            android:textStyle="bold"
            android:contentDescription="@string/desc_keyboard" />

        <!-- Atalho direto para a digitação de texto (TextInputBottomSheet),
             sem precisar passar pelo teclado numérico "123" primeiro. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbc"
            style="@style/Widget.Fluent.Button.Pill"
            android:layout_width="50dp"
            android:layout_height="34dp"
            android:layout_marginStart="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="0dp"
            android:paddingVertical="0dp"
            android:text="ABC"
            android:textSize="14sp"
            android:textStyle="bold"
            android:contentDescription="@string/desc_abc" />

        <ImageView
            android:id="@+id/btnAssistant"
            style="@style/Widget.Fluent.IconCircle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="20dp"
            android:padding="15dp"
            android:src="@drawable/ic_mic"
            android:contentDescription="@string/desc_assistant" />

    </LinearLayout>

    <!-- ===================== D-PAD ===================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dpadContainer"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/legacy_bg_dpad_outer"
        app:layout_constraintBottom_toTopOf="@id/rowMiddleControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rowTop">

        <ImageView
            android:id="@+id/btnDpadUp"
            style="@style/Widget.Fluent.IconCircle"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:padding="20dp"
            android:src="@drawable/ic_chevron_up"
            android:contentDescription="@string/desc_dpad_up"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnDpadDown"
            style="@style/Widget.Fluent.IconCircle"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:padding="20dp"
            android:src="@drawable/ic_chevron_down"
            android:contentDescription="@string/desc_dpad_down"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/btnDpadLeft"
            style="@style/Widget.Fluent.IconCircle"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:padding="20dp"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="@string/desc_dpad_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnDpadRight"
            style="@style/Widget.Fluent.IconCircle"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:padding="20dp"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="@string/desc_dpad_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btnDpadOk"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/fluent_bg_button_glass_circle_selected"
            android:clickable="true"
            android:contentDescription="@string/desc_dpad_ok"
            android:focusable="true"
            android:stateListAnimator="@animator/fluent_button_press"
            android:gravity="center"
            android:text="OK"
            android:textColor="?attr/colorAccent"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===================== VOLTAR / HOME / PLAY-PAUSE ===================== -->
    <LinearLayout
        android:id="@+id/rowMiddleControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/rowVolumeChannel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dpadContainer">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.Fluent.IconCircle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/desc_back"
            android:padding="15dp"
            android:src="@drawable/ic_back" />

        <ImageView
            android:id="@+id/btnHome"
            style="@style/Widget.Fluent.IconCircle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="28dp"
            android:padding="14dp"
            android:src="@drawable/ic_home"
            android:contentDescription="@string/desc_home" />

        <ImageView
            android:id="@+id/btnPlayPause"
            style="@style/Widget.Fluent.IconCircle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="28dp"
            android:padding="15dp"
            android:src="@drawable/ic_play_pause"
            android:contentDescription="@string/desc_play_pause" />

    </LinearLayout>

    <!-- ===================== VOLUME / CANAL ===================== -->

    <!-- ===================== NETFLIX / PRIME / GLOBOPLAY / APPS ===================== -->

    <LinearLayout
        android:id="@+id/rowVolumeChannel"
        android:layout_width="202dp"
        android:layout_height="151dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/rowStreaming"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rowMiddleControls">

        <!-- Coluna Volume -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btnVolumeUp"
                style="@style/Widget.Fluent.IconCircle"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/desc_volume_up"
                android:padding="15dp"
                android:src="@drawable/ic_add" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:text="VOL"
                android:textAppearance="@style/TextAppearance.Fluent.Caption" />

            <ImageView
                android:id="@+id/btnVolumeDown"
                style="@style/Widget.Fluent.IconCircle"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/desc_volume_down"
                android:padding="15dp"
                android:src="@drawable/ic_remove" />

        </LinearLayout>

        <!-- Botão Mute: fica no meio, entre as duas colunas — não pertence
             nem a Volume nem a Canal, então ganha uma posição neutra,
             centralizada verticalmente em relação às duas colunas, em vez
             de disputar espaço dentro de uma delas. -->
        <ImageView
            android:id="@+id/btnMute"
            style="@style/Widget.Fluent.IconCircle.Secondary"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="20dp"
            android:contentDescription="@string/desc_mute"
            android:padding="13dp"
            android:src="@drawable/ic_volume_off" />

        <!-- Coluna Canal -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btnChannelUp"
                style="@style/Widget.Fluent.IconCircle"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/desc_channel_up"
                android:padding="15dp"
                android:src="@drawable/ic_chevron_up" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:text="CH"
                android:textAppearance="@style/TextAppearance.Fluent.Caption" />

            <ImageView
                android:id="@+id/btnChannelDown"
                style="@style/Widget.Fluent.IconCircle"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/desc_channel_down"
                android:padding="15dp"
                android:src="@drawable/ic_chevron_down" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowStreaming"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/containerReconnecting"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rowVolumeChannel">

        <TextView
            android:id="@+id/btnNetflix"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/legacy_ripple_circle_netflix"
            android:clickable="true"
            android:contentDescription="@string/desc_netflix"
            android:focusable="true"
            android:stateListAnimator="@animator/fluent_button_press"
            android:gravity="center"
            android:text="N"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPrimeVideo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/legacy_ripple_circle_prime"
            android:clickable="true"
            android:contentDescription="@string/desc_prime"
            android:focusable="true"
            android:stateListAnimator="@animator/fluent_button_press"
            android:gravity="center"
            android:text="P"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnGloboplay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/legacy_ripple_circle_globoplay"
            android:clickable="true"
            android:contentDescription="@string/desc_globoplay"
            android:focusable="true"
            android:stateListAnimator="@animator/fluent_button_press"
            android:gravity="center"
            android:text="G"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Abre o AppsBottomSheet com a grade de apps disponíveis. -->
        <ImageView
            android:id="@+id/btnApps"
            style="@style/Widget.Fluent.IconCircle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:padding="15dp"
            android:src="@drawable/ic_apps"
            android:contentDescription="@string/desc_apps" />

    </LinearLayout>

    <!-- ===================== INDICADOR "RECONECTANDO" (v0.9.3, item 1) =====================
         Só aparece durante reconexão AUTOMÁTICA (backoff em segundo plano ou
         tentativa proativa ao voltar pro app) - nunca durante um pareamento
         manual novo, que já tem seu próprio feedback na tela de descoberta.
         Controlado por MainActivity.showReconnectIndicator()/hideReconnectIndicator(),
         a partir de DiagnosticState.isAutoReconnecting. GONE por padrão para
         não ocupar espaço nenhum enquanto não está em uso (ver rowStreaming,
         que cede espaço para este container quando ele fica visível). -->
    <LinearLayout
        android:id="@+id/containerReconnecting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/imgReconnecting"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_reconnecting"
            android:tint="?attr/colorTextSecondary"
            android:contentDescription="@string/desc_reconnecting_icon" />

        <TextView
            android:id="@+id/txtReconnecting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="@style/TextAppearance.Fluent.Caption"
            tools:text="Reconectando a Samsung Q60…" />

    </LinearLayout>

    <!-- ===================== PAINEL DE DIAGNÓSTICO (overlay, apenas dev — visual "console") =====================
         *** v0.9.3 (correção pós-lançamento) - painel SIMPLIFICADO para
         leigos ***: só os blocos "TV" (Nome + Status) e "Última
         atividade" (Erro + Ping). O stream de log cru (passos técnicos
         tipo "[LG-PAIRING] 3/6", nomes de mensagem de protocolo etc.) foi
         REMOVIDO deste painel a pedido explícito - não é algo que um
         usuário comum vá interpretar, e ocupava a maior parte da tela.
         Esse stream não desapareceu do app: ele é exatamente o que o
         Diagnóstico Aprofundado (item 4, `DeepDiagnosticActivity`) mostra
         por inteiro, para quem quiser ver o processo passo a passo. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/panelDiagnostic"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/groupDiagnosticInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp"
            android:clickable="false"
            android:focusable="false"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Seção: TV (Nome/Status - só o essencial para quem não é dev) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_section_tv"
                android:textAppearance="@style/TextAppearance.Fluent.SectionTitle"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/txtDiagnosticTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:clickable="false"
                android:focusable="false"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:lineSpacingExtra="4dp"
                android:textColor="?attr/colorAccent"
                android:textIsSelectable="false"
                android:textSize="12sp"
                tools:text="Nome..............Samsung Q60\nStatus............Conectado" />

            <!-- Seção: Última atividade (Erro/Ping - "Último comando"/"Resposta"
                 removidos a pedido explícito: texto técnico de protocolo,
                 sem valor para o usuário comum, ocupava espaço à toa) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/diagnostic_section_activity"
                android:textAppearance="@style/TextAppearance.Fluent.SectionTitle"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/txtDiagnosticActivity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:clickable="false"
                android:focusable="false"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:lineSpacingExtra="4dp"
                android:textColor="?attr/colorAccent"
                android:textIsSelectable="false"
                android:textSize="12sp"
                tools:text="Erro..............—\nPing..............32 ms" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
<!-- ^ fim do conteúdo principal (id=root). A partir daqui, filho do DrawerLayout. -->

<include
    android:id="@+id/drawerContent"
    layout="@layout/drawer_content"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
