<?xml version="1.0" encoding="utf-8"?>
<!--
    Card de app na grade do AppsBottomSheet. Cor de fundo e texto são
    preenchidos em runtime pelo AppsAdapter a partir de AppItem — este
    layout não conhece nenhum app específico.

    Cantos quadrados (18dp) em vez de círculo — visual de "prateleira
    de streaming" pedido no design, mantendo a cor de marca como leve
    tint de fundo em vez de preenchimento sólido.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/appCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="12dp"
    android:stateListAnimator="@animator/fluent_button_press">

    <TextView
        android:id="@+id/appIcon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/fluent_bg_glass_fill"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="?attr/colorTextPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:background="@drawable/legacy_ripple_circle_netflix"
        tools:text="N" />

    <TextView
        android:id="@+id/appLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.Fluent.Caption"
        tools:text="Netflix" />

</LinearLayout>
